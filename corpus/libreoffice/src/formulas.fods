<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" xmlns:dc="http://purl.org/dc/elements/1.1/" xmlns:meta="urn:oasis:names:tc:opendocument:xmlns:meta:1.0" xmlns:of="urn:oasis:names:tc:opendocument:xmlns:of:1.2" office:version="1.3" office:mimetype="application/vnd.oasis.opendocument.spreadsheet">
 <office:meta><dc:title>Formulas</dc:title><dc:language>en-US</dc:language></office:meta>
 <office:styles>
  <style:default-style style:family="table-cell"><style:text-properties fo:language="en" fo:country="US"/></style:default-style>
 </office:styles>
 <office:body>
  <office:spreadsheet>
   <table:calculation-settings table:use-regular-expressions="false" table:use-wildcards="true"/>
   <table:table table:name="Data">
    <table:table-row><table:table-cell office:value-type="string"><text:p>Item</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>Qty</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>Price</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>Date</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>Flag</text:p></table:table-cell></table:table-row>
    <table:table-row><table:table-cell office:value-type="string"><text:p>apple</text:p></table:table-cell><table:table-cell office:value-type="float" office:value="4"><text:p>4</text:p></table:table-cell><table:table-cell office:value-type="float" office:value="1.5"><text:p>1.5</text:p></table:table-cell><table:table-cell office:value-type="date" office:date-value="2026-01-15"><text:p>2026-01-15</text:p></table:table-cell><table:table-cell office:value-type="boolean" office:boolean-value="true"><text:p>TRUE</text:p></table:table-cell></table:table-row>
    <table:table-row><table:table-cell office:value-type="string"><text:p>pear</text:p></table:table-cell><table:table-cell office:value-type="float" office:value="2"><text:p>2</text:p></table:table-cell><table:table-cell office:value-type="float" office:value="3"><text:p>3</text:p></table:table-cell><table:table-cell office:value-type="date" office:date-value="2026-02-28"><text:p>2026-02-28</text:p></table:table-cell><table:table-cell office:value-type="boolean" office:boolean-value="false"><text:p>FALSE</text:p></table:table-cell></table:table-row>
    <table:table-row><table:table-cell office:value-type="string"><text:p>Apple</text:p></table:table-cell><table:table-cell office:value-type="float" office:value="6"><text:p>6</text:p></table:table-cell><table:table-cell office:value-type="float" office:value="0.25"><text:p>0.25</text:p></table:table-cell><table:table-cell office:value-type="date" office:date-value="2025-12-31"><text:p>2025-12-31</text:p></table:table-cell><table:table-cell office:value-type="boolean" office:boolean-value="true"><text:p>TRUE</text:p></table:table-cell></table:table-row>
    <table:table-row><table:table-cell office:value-type="string"><text:p>plum</text:p></table:table-cell><table:table-cell office:value-type="float" office:value="0"><text:p>0</text:p></table:table-cell><table:table-cell office:value-type="float" office:value="10"><text:p>10</text:p></table:table-cell><table:table-cell/><table:table-cell/></table:table-row>
    <table:table-row><table:table-cell/><table:table-cell office:value-type="string"><text:p>n/a</text:p></table:table-cell><table:table-cell office:value-type="float" office:value="7"><text:p>7</text:p></table:table-cell><table:table-cell/><table:table-cell/></table:table-row>
   </table:table>
   <table:table table:name="Calc">
    <table:table-row><table:table-cell office:value-type="string"><text:p>arithmetic</text:p></table:table-cell><table:table-cell table:formula="of:=[$Data.B2]+[$Data.C2]*2"/></table:table-row>
    <table:table-row><table:table-cell office:value-type="string"><text:p>parentheses</text:p></table:table-cell><table:table-cell table:formula="of:=([$Data.B2]+[$Data.C2])*2"/></table:table-row>
    <table:table-row><table:table-cell office:value-type="string"><text:p>power</text:p></table:table-cell><table:table-cell table:formula="of:=2^10"/></table:table-row>
    <table:table-row><table:table-cell office:value-type="string"><text:p>negation</text:p></table:table-cell><table:table-cell table:formula="of:=-[$Data.B3]"/></table:table-row>
    <table:table-row><table:table-cell office:value-type="string"><text:p>percent</text:p></table:table-cell><table:table-cell table:formula="of:=50%"/></table:table-row>
    <table:table-row><table:table-cell office:value-type="string"><text:p>division by zero</text:p></table:table-cell><table:table-cell table:formula="of:=[$Data.B2]/[$Data.B5]"/></table:table-row>
    <table:table-row><table:table-cell office:value-type="string"><text:p>join</text:p></table:table-cell><table:table-cell table:formula='of:=[$Data.A2]&amp;" x"&amp;[$Data.B2]'/></table:table-row>
    <table:table-row><table:table-cell office:value-type="string"><text:p>greater</text:p></table:table-cell><table:table-cell table:formula="of:=[$Data.B2]&gt;[$Data.B3]"/></table:table-row>
    <table:table-row><table:table-cell office:value-type="string"><text:p>not equal</text:p></table:table-cell><table:table-cell table:formula="of:=[$Data.B2]&lt;&gt;[$Data.B3]"/></table:table-row>
    <table:table-row><table:table-cell office:value-type="string"><text:p>text equal, any case</text:p></table:table-cell><table:table-cell table:formula='of:=[$Data.A2]="APPLE"'/></table:table-row>
    <table:table-row><table:table-cell office:value-type="string"><text:p>empty cell</text:p></table:table-cell><table:table-cell table:formula="of:=[$Data.Z99]+1"/></table:table-row>
    <table:table-row><table:table-cell office:value-type="string"><text:p>text as number</text:p></table:table-cell><table:table-cell table:formula='of:="3"+1'/></table:table-row>
    <table:table-row><table:table-cell office:value-type="string"><text:p>text not a number</text:p></table:table-cell><table:table-cell table:formula='of:="abc"+1'/></table:table-row>
    <table:table-row><table:table-cell office:value-type="string"><text:p>true plus one</text:p></table:table-cell><table:table-cell table:formula="of:=TRUE()+1"/></table:table-row>
    <table:table-row><table:table-cell office:value-type="string"><text:p>sum of a column</text:p></table:table-cell><table:table-cell table:formula="of:=SUM([$Data.B2:.B6])"/></table:table-row>
    <table:table-row><table:table-cell office:value-type="string"><text:p>sum of a block</text:p></table:table-cell><table:table-cell table:formula="of:=SUM([$Data.B2:.C6])"/></table:table-row>
    <table:table-row><table:table-cell office:value-type="string"><text:p>sum of arguments</text:p></table:table-cell><table:table-cell table:formula="of:=SUM([$Data.B2];[$Data.C2];10)"/></table:table-row>
    <table:table-row><table:table-cell office:value-type="string"><text:p>average</text:p></table:table-cell><table:table-cell table:formula="of:=AVERAGE([$Data.B2:.B6])"/></table:table-row>
    <table:table-row><table:table-cell office:value-type="string"><text:p>min</text:p></table:table-cell><table:table-cell table:formula="of:=MIN([$Data.C2:.C6])"/></table:table-row>
    <table:table-row><table:table-cell office:value-type="string"><text:p>max</text:p></table:table-cell><table:table-cell table:formula="of:=MAX([$Data.C2:.C6])"/></table:table-row>
    <table:table-row><table:table-cell office:value-type="string"><text:p>count</text:p></table:table-cell><table:table-cell table:formula="of:=COUNT([$Data.A2:.C6])"/></table:table-row>
    <table:table-row><table:table-cell office:value-type="string"><text:p>counta</text:p></table:table-cell><table:table-cell table:formula="of:=COUNTA([$Data.A2:.C6])"/></table:table-row>
    <table:table-row><table:table-cell office:value-type="string"><text:p>countblank</text:p></table:table-cell><table:table-cell table:formula="of:=COUNTBLANK([$Data.A2:.E6])"/></table:table-row>
    <table:table-row><table:table-cell office:value-type="string"><text:p>product</text:p></table:table-cell><table:table-cell table:formula="of:=PRODUCT([$Data.B2:.B4])"/></table:table-row>
    <table:table-row><table:table-cell office:value-type="string"><text:p>if true</text:p></table:table-cell><table:table-cell table:formula='of:=IF([$Data.B2]&gt;3;"big";"small")'/></table:table-row>
    <table:table-row><table:table-cell office:value-type="string"><text:p>if false</text:p></table:table-cell><table:table-cell table:formula='of:=IF([$Data.B3]&gt;3;"big";"small")'/></table:table-row>
    <table:table-row><table:table-cell office:value-type="string"><text:p>if on zero</text:p></table:table-cell><table:table-cell table:formula="of:=IF([$Data.B5];1;2)"/></table:table-row>
    <table:table-row><table:table-cell office:value-type="string"><text:p>iferror</text:p></table:table-cell><table:table-cell table:formula='of:=IFERROR([$Data.B2]/[$Data.B5];"none")'/></table:table-row>
    <table:table-row><table:table-cell office:value-type="string"><text:p>and</text:p></table:table-cell><table:table-cell table:formula="of:=AND(TRUE();[$Data.B2]&gt;1)"/></table:table-row>
    <table:table-row><table:table-cell office:value-type="string"><text:p>or</text:p></table:table-cell><table:table-cell table:formula="of:=OR(FALSE();0)"/></table:table-row>
    <table:table-row><table:table-cell office:value-type="string"><text:p>not</text:p></table:table-cell><table:table-cell table:formula="of:=NOT([$Data.E2])"/></table:table-row>
    <table:table-row><table:table-cell office:value-type="string"><text:p>round half up</text:p></table:table-cell><table:table-cell table:formula="of:=ROUND(2.5;0)"/></table:table-row>
    <table:table-row><table:table-cell office:value-type="string"><text:p>round negative half</text:p></table:table-cell><table:table-cell table:formula="of:=ROUND(-2.5;0)"/></table:table-row>
    <table:table-row><table:table-cell office:value-type="string"><text:p>round to cents</text:p></table:table-cell><table:table-cell table:formula="of:=ROUND(1234.5678;2)"/></table:table-row>
    <table:table-row><table:table-cell office:value-type="string"><text:p>round to hundreds</text:p></table:table-cell><table:table-cell table:formula="of:=ROUND(1234.5;-2)"/></table:table-row>
    <table:table-row><table:table-cell office:value-type="string"><text:p>roundup</text:p></table:table-cell><table:table-cell table:formula="of:=ROUNDUP(1.21;1)"/></table:table-row>
    <table:table-row><table:table-cell office:value-type="string"><text:p>rounddown</text:p></table:table-cell><table:table-cell table:formula="of:=ROUNDDOWN(-1.29;1)"/></table:table-row>
    <table:table-row><table:table-cell office:value-type="string"><text:p>abs</text:p></table:table-cell><table:table-cell table:formula="of:=ABS(-3)"/></table:table-row>
    <table:table-row><table:table-cell office:value-type="string"><text:p>int</text:p></table:table-cell><table:table-cell table:formula="of:=INT(-2.5)"/></table:table-row>
    <table:table-row><table:table-cell office:value-type="string"><text:p>mod</text:p></table:table-cell><table:table-cell table:formula="of:=MOD(-7;3)"/></table:table-row>
    <table:table-row><table:table-cell office:value-type="string"><text:p>power function</text:p></table:table-cell><table:table-cell table:formula="of:=POWER(2;0.5)"/></table:table-row>
    <table:table-row><table:table-cell office:value-type="string"><text:p>sqrt</text:p></table:table-cell><table:table-cell table:formula="of:=SQRT(16)"/></table:table-row>
    <table:table-row><table:table-cell office:value-type="string"><text:p>concatenate</text:p></table:table-cell><table:table-cell table:formula='of:=CONCATENATE("a";1;TRUE())'/></table:table-row>
    <table:table-row><table:table-cell office:value-type="string"><text:p>left</text:p></table:table-cell><table:table-cell table:formula='of:=LEFT("hello";2)'/></table:table-row>
    <table:table-row><table:table-cell office:value-type="string"><text:p>right</text:p></table:table-cell><table:table-cell table:formula='of:=RIGHT("hello";3)'/></table:table-row>
    <table:table-row><table:table-cell office:value-type="string"><text:p>mid</text:p></table:table-cell><table:table-cell table:formula='of:=MID("hello";2;3)'/></table:table-row>
    <table:table-row><table:table-cell office:value-type="string"><text:p>len</text:p></table:table-cell><table:table-cell table:formula='of:=LEN("héllo")'/></table:table-row>
    <table:table-row><table:table-cell office:value-type="string"><text:p>upper</text:p></table:table-cell><table:table-cell table:formula='of:=UPPER("Mixed")'/></table:table-row>
    <table:table-row><table:table-cell office:value-type="string"><text:p>lower</text:p></table:table-cell><table:table-cell table:formula='of:=LOWER("Mixed")'/></table:table-row>
    <table:table-row><table:table-cell office:value-type="string"><text:p>trim</text:p></table:table-cell><table:table-cell table:formula='of:=TRIM("  a   b ")'/></table:table-row>
    <table:table-row><table:table-cell office:value-type="string"><text:p>date</text:p></table:table-cell><table:table-cell table:formula="of:=DATE(2026;11;5)"/></table:table-row>
    <table:table-row><table:table-cell office:value-type="string"><text:p>year</text:p></table:table-cell><table:table-cell table:formula="of:=YEAR([$Data.D2])"/></table:table-row>
    <table:table-row><table:table-cell office:value-type="string"><text:p>month</text:p></table:table-cell><table:table-cell table:formula="of:=MONTH([$Data.D3])"/></table:table-row>
    <table:table-row><table:table-cell office:value-type="string"><text:p>day</text:p></table:table-cell><table:table-cell table:formula="of:=DAY([$Data.D4])"/></table:table-row>
    <table:table-row><table:table-cell office:value-type="string"><text:p>date plus days</text:p></table:table-cell><table:table-cell table:formula="of:=[$Data.D2]+30"/></table:table-row>
    <table:table-row><table:table-cell office:value-type="string"><text:p>days between</text:p></table:table-cell><table:table-cell table:formula="of:=[$Data.D3]-[$Data.D2]"/></table:table-row>
    <table:table-row><table:table-cell office:value-type="string"><text:p>vlookup exact</text:p></table:table-cell><table:table-cell table:formula='of:=VLOOKUP("pear";[$Data.A2:.C6];3;0)'/></table:table-row>
    <table:table-row><table:table-cell office:value-type="string"><text:p>vlookup missing</text:p></table:table-cell><table:table-cell table:formula='of:=VLOOKUP("kiwi";[$Data.A2:.C6];3;0)'/></table:table-row>
    <table:table-row><table:table-cell office:value-type="string"><text:p>vlookup sorted</text:p></table:table-cell><table:table-cell table:formula="of:=VLOOKUP(5;[$Data.B2:.C4];2;1)"/></table:table-row>
    <table:table-row><table:table-cell office:value-type="string"><text:p>sumif text</text:p></table:table-cell><table:table-cell table:formula='of:=SUMIF([$Data.A2:.A6];"apple";[$Data.B2:.B6])'/></table:table-row>
    <table:table-row><table:table-cell office:value-type="string"><text:p>sumif condition</text:p></table:table-cell><table:table-cell table:formula='of:=SUMIF([$Data.B2:.B6];"&gt;2")'/></table:table-row>
    <table:table-row><table:table-cell office:value-type="string"><text:p>countif</text:p></table:table-cell><table:table-cell table:formula='of:=COUNTIF([$Data.B2:.B6];"&gt;=2")'/></table:table-row>
    <table:table-row><table:table-cell office:value-type="string"><text:p>depends on a formula</text:p></table:table-cell><table:table-cell table:formula="of:=[.B2]*2"/></table:table-row>
    <table:table-row><table:table-cell office:value-type="string"><text:p>absolute reference</text:p></table:table-cell><table:table-cell table:formula="of:=[$Data.$B$2]*[$Data.$C$3]"/></table:table-row>
    <table:table-row><table:table-cell office:value-type="string"><text:p>round just below a half</text:p></table:table-cell><table:table-cell table:formula='of:=ROUND(0.4999999999;0)'/></table:table-row>
    <table:table-row><table:table-cell office:value-type="string"><text:p>rounddown just below one</text:p></table:table-cell><table:table-cell table:formula='of:=ROUNDDOWN(0.9999999999;0)'/></table:table-row>
    <table:table-row><table:table-cell office:value-type="string"><text:p>roundup just past one</text:p></table:table-cell><table:table-cell table:formula='of:=ROUNDUP(1.0000000001;0)'/></table:table-row>
    <table:table-row><table:table-cell office:value-type="string"><text:p>round a huge number</text:p></table:table-cell><table:table-cell table:formula='of:=ROUND(1E300;0)'/></table:table-row>
    <table:table-row><table:table-cell office:value-type="string"><text:p>round to many places</text:p></table:table-cell><table:table-cell table:formula='of:=ROUND(1;400)'/></table:table-row>
    <table:table-row><table:table-cell office:value-type="string"><text:p>round a written half</text:p></table:table-cell><table:table-cell table:formula='of:=ROUND(1.005;2)'/></table:table-row>
    <table:table-row><table:table-cell office:value-type="string"><text:p>sum near equal</text:p></table:table-cell><table:table-cell table:formula='of:=0.1+0.2=0.3'/></table:table-row>
    <table:table-row><table:table-cell office:value-type="string"><text:p>int of a product</text:p></table:table-cell><table:table-cell table:formula='of:=INT(4.35*100)'/></table:table-row>
    <table:table-row><table:table-cell office:value-type="string"><text:p>cancelling terms</text:p></table:table-cell><table:table-cell table:formula='of:=0.3-0.1-0.2'/></table:table-row>
    <table:table-row><table:table-cell office:value-type="string"><text:p>text order across case</text:p></table:table-cell><table:table-cell table:formula='of:="a"&lt;"B"'/></table:table-row>
    <table:table-row><table:table-cell office:value-type="string"><text:p>text order after case</text:p></table:table-cell><table:table-cell table:formula='of:="Z"&lt;"a"'/></table:table-row>
    <table:table-row><table:table-cell office:value-type="string"><text:p>concat</text:p></table:table-cell><table:table-cell table:formula='of:=COM.MICROSOFT.CONCAT("a";[$Data.A3])'/></table:table-row>
    <table:table-row><table:table-cell office:value-type="string"><text:p>countif wildcard</text:p></table:table-cell><table:table-cell table:formula='of:=COUNTIF([$Data.A2:.A6];"ap*")'/></table:table-row>
    <table:table-row><table:table-cell office:value-type="string"><text:p>sumif wildcard</text:p></table:table-cell><table:table-cell table:formula='of:=SUMIF([$Data.A2:.A6];"?pple";[$Data.B2:.B6])'/></table:table-row>
    <table:table-row><table:table-cell office:value-type="string"><text:p>vlookup wildcard</text:p></table:table-cell><table:table-cell table:formula='of:=VLOOKUP("pe*";[$Data.A2:.C6];2;0)'/></table:table-row>
    <table:table-row><table:table-cell office:value-type="string"><text:p>sum of nothing</text:p></table:table-cell><table:table-cell table:formula='of:=SUM([$Data.Z90:.Z91])'/></table:table-row>
    <table:table-row><table:table-cell office:value-type="string"><text:p>text inf</text:p></table:table-cell><table:table-cell table:formula='of:="inf"+1'/></table:table-row>
    <table:table-row><table:table-cell office:value-type="string"><text:p>sqrt of negative</text:p></table:table-cell><table:table-cell table:formula="of:=SQRT(-1)"/></table:table-row>
    <table:table-row><table:table-cell office:value-type="string"><text:p>left negative</text:p></table:table-cell><table:table-cell table:formula="of:=LEFT(&quot;abc&quot;;-1)"/></table:table-row>
    <table:table-row><table:table-cell office:value-type="string"><text:p>right negative</text:p></table:table-cell><table:table-cell table:formula="of:=RIGHT(&quot;abc&quot;;-0.5)"/></table:table-row>
    <table:table-row><table:table-cell office:value-type="string"><text:p>mid from zero</text:p></table:table-cell><table:table-cell table:formula="of:=MID(&quot;abc&quot;;0;1)"/></table:table-row>
    <table:table-row><table:table-cell office:value-type="string"><text:p>mid negative length</text:p></table:table-cell><table:table-cell table:formula="of:=MID(&quot;abc&quot;;1;-1)"/></table:table-row>
    <table:table-row><table:table-cell office:value-type="string"><text:p>mid past the end</text:p></table:table-cell><table:table-cell table:formula="of:=MID(&quot;abc&quot;;5;1)"/></table:table-row>
    <table:table-row><table:table-cell office:value-type="string"><text:p>max of nothing</text:p></table:table-cell><table:table-cell table:formula="of:=MAX()"/></table:table-row>
    <table:table-row><table:table-cell office:value-type="string"><text:p>min of nothing</text:p></table:table-cell><table:table-cell table:formula="of:=MIN()"/></table:table-row>
    <table:table-row><table:table-cell office:value-type="string"><text:p>min of text</text:p></table:table-cell><table:table-cell table:formula="of:=MIN(&quot;a&quot;)"/></table:table-row>
    <table:table-row><table:table-cell office:value-type="string"><text:p>max of number text</text:p></table:table-cell><table:table-cell table:formula="of:=MAX(&quot;3&quot;;1)"/></table:table-row>
    <table:table-row><table:table-cell office:value-type="string"><text:p>min of a boolean</text:p></table:table-cell><table:table-cell table:formula="of:=MAX(TRUE();-1)"/></table:table-row>
    <table:table-row><table:table-cell office:value-type="string"><text:p>vlookup column out</text:p></table:table-cell><table:table-cell table:formula="of:=VLOOKUP(&quot;pear&quot;;[$Data.A2:.C6];5;0)"/></table:table-row>
    <table:table-row><table:table-cell office:value-type="string"><text:p>vlookup column zero</text:p></table:table-cell><table:table-cell table:formula="of:=VLOOKUP(&quot;pear&quot;;[$Data.A2:.C6];0;0)"/></table:table-row>
    <table:table-row><table:table-cell office:value-type="string"><text:p>vlookup column text</text:p></table:table-cell><table:table-cell table:formula="of:=VLOOKUP(&quot;pear&quot;;[$Data.A2:.C6];&quot;x&quot;;0)"/></table:table-row>
