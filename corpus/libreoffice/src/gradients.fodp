<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:draw="urn:oasis:names:tc:opendocument:xmlns:drawing:1.0" xmlns:presentation="urn:oasis:names:tc:opendocument:xmlns:presentation:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" xmlns:svg="urn:oasis:names:tc:opendocument:xmlns:svg-compatible:1.0" xmlns:dc="http://purl.org/dc/elements/1.1/" office:version="1.3" office:mimetype="application/vnd.oasis.opendocument.presentation">
 <office:meta><dc:title>Gradients</dc:title><dc:language>en-US</dc:language></office:meta>
 <office:styles>
   <draw:gradient draw:name="Run0" draw:style="radial" draw:start-color="#000000" draw:end-color="#ffffff" draw:start-intensity="100%" draw:end-intensity="100%" draw:cx="50%" draw:cy="50%" draw:border="0%" draw:angle="0deg"/>
   <draw:gradient draw:name="Run1" draw:style="radial" draw:start-color="#000000" draw:end-color="#ffffff" draw:start-intensity="100%" draw:end-intensity="100%" draw:cx="25%" draw:cy="75%" draw:border="20%" draw:angle="30deg"/>
   <draw:gradient draw:name="Run2" draw:style="ellipsoid" draw:start-color="#000000" draw:end-color="#ffffff" draw:start-intensity="100%" draw:end-intensity="100%" draw:cx="50%" draw:cy="50%" draw:border="0%" draw:angle="0deg"/>
   <draw:gradient draw:name="Run3" draw:style="ellipsoid" draw:start-color="#000000" draw:end-color="#ffffff" draw:start-intensity="100%" draw:end-intensity="100%" draw:cx="25%" draw:cy="75%" draw:border="20%" draw:angle="30deg"/>
   <draw:gradient draw:name="Run4" draw:style="square" draw:start-color="#000000" draw:end-color="#ffffff" draw:start-intensity="100%" draw:end-intensity="100%" draw:cx="50%" draw:cy="50%" draw:border="0%" draw:angle="0deg"/>
   <draw:gradient draw:name="Run5" draw:style="square" draw:start-color="#000000" draw:end-color="#ffffff" draw:start-intensity="100%" draw:end-intensity="100%" draw:cx="25%" draw:cy="75%" draw:border="20%" draw:angle="30deg"/>
   <draw:gradient draw:name="Run6" draw:style="rectangular" draw:start-color="#000000" draw:end-color="#ffffff" draw:start-intensity="100%" draw:end-intensity="100%" draw:cx="50%" draw:cy="50%" draw:border="0%" draw:angle="0deg"/>
   <draw:gradient draw:name="Run7" draw:style="rectangular" draw:start-color="#000000" draw:end-color="#ffffff" draw:start-intensity="100%" draw:end-intensity="100%" draw:cx="25%" draw:cy="75%" draw:border="20%" draw:angle="30deg"/>
   <draw:gradient draw:name="Dimmed" draw:style="linear" draw:start-color="#ffffff" draw:end-color="#000000" draw:start-intensity="50%" draw:end-intensity="100%" draw:angle="90deg" draw:border="0%"/>
   <style:style style:name="shape0" style:family="graphic"><style:graphic-properties draw:fill="gradient" draw:fill-gradient-name="Run0" draw:stroke="none"/></style:style>
   <style:style style:name="shape1" style:family="graphic"><style:graphic-properties draw:fill="gradient" draw:fill-gradient-name="Run1" draw:stroke="none"/></style:style>
   <style:style style:name="shape2" style:family="graphic"><style:graphic-properties draw:fill="gradient" draw:fill-gradient-name="Run2" draw:stroke="none"/></style:style>
   <style:style style:name="shape3" style:family="graphic"><style:graphic-properties draw:fill="gradient" draw:fill-gradient-name="Run3" draw:stroke="none"/></style:style>
   <style:style style:name="shape4" style:family="graphic"><style:graphic-properties draw:fill="gradient" draw:fill-gradient-name="Run4" draw:stroke="none"/></style:style>
   <style:style style:name="shape5" style:family="graphic"><style:graphic-properties draw:fill="gradient" draw:fill-gradient-name="Run5" draw:stroke="none"/></style:style>
   <style:style style:name="shape6" style:family="graphic"><style:graphic-properties draw:fill="gradient" draw:fill-gradient-name="Run6" draw:stroke="none"/></style:style>
   <style:style style:name="shape7" style:family="graphic"><style:graphic-properties draw:fill="gradient" draw:fill-gradient-name="Run7" draw:stroke="none"/></style:style>
   <style:style style:name="shape8" style:family="graphic"><style:graphic-properties draw:fill="gradient" draw:fill-gradient-name="Dimmed" draw:stroke="none"/></style:style>
 </office:styles>
 <office:automatic-styles>
   <style:page-layout style:name="Page"><style:page-layout-properties fo:page-width="28cm" fo:page-height="15.75cm" fo:margin-top="0cm" fo:margin-bottom="0cm" fo:margin-left="0cm" fo:margin-right="0cm"/></style:page-layout>
 </office:automatic-styles>
 <office:master-styles><style:master-page style:name="Plain" style:page-layout-name="Page"/></office:master-styles>
 <office:body>
  <office:presentation>
   <draw:page draw:name="Radial, centred" draw:master-page-name="Plain"><draw:frame presentation:class="title" svg:x="1cm" svg:y="0.5cm" svg:width="26cm" svg:height="2cm"><draw:text-box><text:p>Radial, centred</text:p></draw:text-box></draw:frame><draw:rect draw:style-name="shape0" svg:x="3cm" svg:y="3cm" svg:width="11cm" svg:height="7cm"/></draw:page>
   <draw:page draw:name="Radial, with a border, off centre and turned" draw:master-page-name="Plain"><draw:frame presentation:class="title" svg:x="1cm" svg:y="0.5cm" svg:width="26cm" svg:height="2cm"><draw:text-box><text:p>Radial, with a border, off centre and turned</text:p></draw:text-box></draw:frame><draw:rect draw:style-name="shape1" svg:x="3cm" svg:y="3cm" svg:width="11cm" svg:height="7cm"/></draw:page>
   <draw:page draw:name="Ellipsoidal, centred" draw:master-page-name="Plain"><draw:frame presentation:class="title" svg:x="1cm" svg:y="0.5cm" svg:width="26cm" svg:height="2cm"><draw:text-box><text:p>Ellipsoidal, centred</text:p></draw:text-box></draw:frame><draw:rect draw:style-name="shape2" svg:x="3cm" svg:y="3cm" svg:width="11cm" svg:height="7cm"/></draw:page>
   <draw:page draw:name="Ellipsoidal, with a border, off centre and turned" draw:master-page-name="Plain"><draw:frame presentation:class="title" svg:x="1cm" svg:y="0.5cm" svg:width="26cm" svg:height="2cm"><draw:text-box><text:p>Ellipsoidal, with a border, off centre and turned</text:p></draw:text-box></draw:frame><draw:rect draw:style-name="shape3" svg:x="3cm" svg:y="3cm" svg:width="11cm" svg:height="7cm"/></draw:page>
   <draw:page draw:name="Square, centred" draw:master-page-name="Plain"><draw:frame presentation:class="title" svg:x="1cm" svg:y="0.5cm" svg:width="26cm" svg:height="2cm"><draw:text-box><text:p>Square, centred</text:p></draw:text-box></draw:frame><draw:rect draw:style-name="shape4" svg:x="3cm" svg:y="3cm" svg:width="11cm" svg:height="7cm"/></draw:page>
   <draw:page draw:name="Square, with a border, off centre and turned" draw:master-page-name="Plain"><draw:frame presentation:class="title" svg:x="1cm" svg:y="0.5cm" svg:width="26cm" svg:height="2cm"><draw:text-box><text:p>Square, with a border, off centre and turned</text:p></draw:text-box></draw:frame><draw:rect draw:style-name="shape5" svg:x="3cm" svg:y="3cm" svg:width="11cm" svg:height="7cm"/></draw:page>
   <draw:page draw:name="Rectangular, centred" draw:master-page-name="Plain"><draw:frame presentation:class="title" svg:x="1cm" svg:y="0.5cm" svg:width="26cm" svg:height="2cm"><draw:text-box><text:p>Rectangular, centred</text:p></draw:text-box></draw:frame><draw:rect draw:style-name="shape6" svg:x="3cm" svg:y="3cm" svg:width="11cm" svg:height="7cm"/></draw:page>
   <draw:page draw:name="Rectangular, with a border, off centre and turned" draw:master-page-name="Plain"><draw:frame presentation:class="title" svg:x="1cm" svg:y="0.5cm" svg:width="26cm" svg:height="2cm"><draw:text-box><text:p>Rectangular, with a border, off centre and turned</text:p></draw:text-box></draw:frame><draw:rect draw:style-name="shape7" svg:x="3cm" svg:y="3cm" svg:width="11cm" svg:height="7cm"/></draw:page>
   <draw:page draw:name="A start colour at half its intensity" draw:master-page-name="Plain"><draw:frame presentation:class="title" svg:x="1cm" svg:y="0.5cm" svg:width="26cm" svg:height="2cm"><draw:text-box><text:p>A start colour at half its intensity</text:p></draw:text-box></draw:frame><draw:rect draw:style-name="shape8" svg:x="3cm" svg:y="3cm" svg:width="11cm" svg:height="7cm"/></draw:page>
  </office:presentation>
 </office:body>
</office:document>
