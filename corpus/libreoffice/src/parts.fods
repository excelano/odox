    <table:table-row><table:table-cell office:value-type="percentage" office:value="0.5"><text:p>50%</text:p></table:table-cell><table:table-cell office:value-type="float" office:value="1048576"><text:p>1048576</text:p></table:table-cell></table:table-row>
    <table:table-row><table:table-cell office:value-type="float" office:value="1E+20"><text:p>1E+20</text:p></table:table-cell><table:table-cell office:value-type="float" office:value="2097152"><text:p>2097152</text:p></table:table-cell></table:table-row>
   </table:table>
   <table:table table:name="Calc">
    <table:table-row><table:table-cell office:value-type="string"><text:p>count ap</text:p></table:table-cell><table:table-cell table:formula="of:=COUNTIF([$Data.A1:.A22];&quot;ap&quot;)"/></table:table-row>
    <table:table-row><table:table-cell office:value-type="string"><text:p>sum ap</text:p></table:table-cell><table:table-cell table:formula="of:=SUMIF([$Data.A1:.A22];&quot;ap&quot;;[$Data.B1:.B22])"/></table:table-row>
    <table:table-row><table:table-cell office:value-type="string"><text:p>lookup ap</text:p></table:table-cell><table:table-cell table:formula="of:=VLOOKUP(&quot;ap&quot;;[$Data.A1:.B22];2;0)"/></table:table-row>
    <table:table-row><table:table-cell office:value-type="string"><text:p>count pp</text:p></table:table-cell><table:table-cell table:formula="of:=COUNTIF([$Data.A1:.A22];&quot;pp&quot;)"/></table:table-row>
    <table:table-row><table:table-cell office:value-type="string"><text:p>sum pp</text:p></table:table-cell><table:table-cell table:formula="of:=SUMIF([$Data.A1:.A22];&quot;pp&quot;;[$Data.B1:.B22])"/></table:table-row>
    <table:table-row><table:table-cell office:value-type="string"><text:p>lookup pp</text:p></table:table-cell><table:table-cell table:formula="of:=VLOOKUP(&quot;pp&quot;;[$Data.A1:.B22];2;0)"/></table:table-row>
    <table:table-row><table:table-cell office:value-type="string"><text:p>count É</text:p></table:table-cell><table:table-cell table:formula="of:=COUNTIF([$Data.A1:.A22];&quot;É&quot;)"/></table:table-row>
    <table:table-row><table:table-cell office:value-type="string"><text:p>sum É</text:p></table:table-cell><table:table-cell table:formula="of:=SUMIF([$Data.A1:.A22];&quot;É&quot;;[$Data.B1:.B22])"/></table:table-row>
    <table:table-row><table:table-cell office:value-type="string"><text:p>lookup É</text:p></table:table-cell><table:table-cell table:formula="of:=VLOOKUP(&quot;É&quot;;[$Data.A1:.B22];2;0)"/></table:table-row>
    <table:table-row><table:table-cell office:value-type="string"><text:p>count 1*</text:p></table:table-cell><table:table-cell table:formula="of:=COUNTIF([$Data.A1:.A22];&quot;1*&quot;)"/></table:table-row>
