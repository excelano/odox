<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:draw="urn:oasis:names:tc:opendocument:xmlns:drawing:1.0" xmlns:presentation="urn:oasis:names:tc:opendocument:xmlns:presentation:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" xmlns:svg="urn:oasis:names:tc:opendocument:xmlns:svg-compatible:1.0" xmlns:dc="http://purl.org/dc/elements/1.1/" xmlns:xlink="http://www.w3.org/1999/xlink" office:version="1.3" office:mimetype="application/vnd.oasis.opendocument.presentation">
 <office:meta><dc:title>Turned labels</dc:title><dc:language>en-US</dc:language></office:meta>
 <office:styles>
  <style:style style:name="box" style:family="graphic"><style:graphic-properties draw:fill="solid" draw:fill-color="#ffe680" draw:stroke="solid" svg:stroke-color="#000000" draw:textarea-vertical-align="middle"/><style:paragraph-properties fo:text-align="center"/><style:text-properties fo:font-size="20pt" fo:color="#000000"/></style:style>
  <style:style style:name="plain" style:family="graphic"><style:graphic-properties draw:fill="none" draw:stroke="none" draw:textarea-vertical-align="top"/><style:text-properties fo:font-size="18pt" fo:color="#000000"/></style:style>
  <style:style style:name="bold" style:family="text"><style:text-properties fo:font-weight="bold" fo:color="#c00000"/></style:style>
 </office:styles>
 <office:automatic-styles>
  <style:page-layout style:name="Page"><style:page-layout-properties fo:page-width="28cm" fo:page-height="15.75cm" fo:margin-top="0cm" fo:margin-bottom="0cm" fo:margin-left="0cm" fo:margin-right="0cm"/></style:page-layout>
  <style:style style:name="dp" style:family="drawing-page"><style:drawing-page-properties draw:fill="solid" draw:fill-color="#ffffff"/></style:style>
 </office:automatic-styles>
 <office:master-styles><style:master-page style:name="Plain" style:page-layout-name="Page" draw:style-name="dp"/></office:master-styles>
 <office:body>
  <office:presentation>
   <draw:page draw:name="Turned labels" draw:master-page-name="Plain">
    <draw:frame presentation:class="title" draw:style-name="plain" svg:x="1cm" svg:y="0.5cm" svg:width="26cm" svg:height="2cm"><draw:text-box><text:p>Turned labels</text:p></draw:text-box></draw:frame>
    <draw:custom-shape draw:style-name="box" svg:width="8cm" svg:height="4cm" draw:transform="rotate (0.523598775598299) translate (3cm 7cm)"><text:p>Turned thirty degrees</text:p><text:p>with <text:span text:style-name="bold">bold</text:span> words</text:p><draw:enhanced-geometry svg:viewBox="0 0 21600 21600" draw:type="rectangle" draw:enhanced-path="M 0 0 L 21600 0 21600 21600 0 21600 0 0 Z N"/></draw:custom-shape>
    <draw:frame draw:style-name="plain" svg:width="9cm" svg:height="2cm" draw:transform="rotate (1.5707963267949) translate (15cm 13cm)"><draw:text-box><text:p>A text box on its side, with <text:a xlink:type="simple" xlink:href="https://example.com/">a link</text:a></text:p></draw:text-box></draw:frame>
    <draw:custom-shape draw:style-name="box" svg:width="7cm" svg:height="3cm" draw:transform="rotate (-0.349065850398866) translate (18cm 3cm)"><text:p>Down twenty</text:p><draw:enhanced-geometry svg:viewBox="0 0 21600 21600" draw:type="ellipse" draw:enhanced-path="U 10800 10800 10800 10800 0 360 Z N"/></draw:custom-shape>
   </draw:page>
  </office:presentation>
 </office:body>
</office:document>
