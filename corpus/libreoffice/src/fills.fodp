<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:draw="urn:oasis:names:tc:opendocument:xmlns:drawing:1.0" xmlns:presentation="urn:oasis:names:tc:opendocument:xmlns:presentation:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" xmlns:svg="urn:oasis:names:tc:opendocument:xmlns:svg-compatible:1.0" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:dc="http://purl.org/dc/elements/1.1/" office:version="1.3" office:mimetype="application/vnd.oasis.opendocument.presentation">
 <office:meta><dc:title>Picture fills</dc:title><dc:language>en-US</dc:language></office:meta>
 <office:styles>
   <draw:fill-image draw:name="Plain"><office:binary-data>iVBORw0KGgoAAAANSUhEUgAAACgAAAAeBAMAAACs80HuAAAAIGNIUk0AAHomAACAhAAA+gAAAIDoAAB1MAAA6mAAADqYAAAXcJy6UTwAAAAPUExURf8AAAAA/wD/AP//AP///7pPlacAAAABYktHRASPaNlRAAAAB3RJTUUH6gsLAQ4YV/f7uwAAABBjYU52AAAAFAAAAA8AAAAAAAAAAPgxJDEAAAAcSURBVCjPY2CAA0E4YBgVJEZQCQ6M4WBUkBhBAKhyO8W8oi2eAAAAAElFTkSuQmCC</office:binary-data></draw:fill-image>
   <draw:fill-image draw:name="Dense"><office:binary-data>iVBORw0KGgoAAAANSUhEUgAAACgAAAAeBAMAAACs80HuAAAAIGNIUk0AAHomAACAhAAA+gAAAIDoAAB1MAAA6mAAADqYAAAXcJy6UTwAAAAPUExURf//AAD/AAAA//8AAP///wCishIAAAABYktHRASPaNlRAAAACXBIWXMAAAsSAAALEgHS3X78AAAAEGNhTnYAAAAUAAAADwAAAAAAAAAA+DEkMQAAABxJREFUKM9jYIADQThgGBUkRlAJDozhYFSQGEEAqHI7xbyiLZ4AAAAASUVORK5CYII=</office:binary-data></draw:fill-image>
   <style:style style:name="fill0" style:family="graphic"><style:graphic-properties draw:fill="bitmap" draw:fill-image-name="Plain" style:repeat="repeat" draw:stroke="solid" svg:stroke-color="#000000"/></style:style>
   <style:style style:name="fill1" style:family="graphic"><style:graphic-properties draw:fill="bitmap" draw:fill-image-name="Plain" style:repeat="repeat" draw:fill-image-width="2cm" draw:fill-image-height="1cm" draw:stroke="solid" svg:stroke-color="#000000"/></style:style>
   <style:style style:name="fill2" style:family="graphic"><style:graphic-properties draw:fill="bitmap" draw:fill-image-name="Plain" style:repeat="repeat" draw:fill-image-width="2cm" draw:fill-image-height="1cm" draw:fill-image-ref-point="bottom-right" draw:stroke="solid" svg:stroke-color="#000000"/></style:style>
   <style:style style:name="fill3" style:family="graphic"><style:graphic-properties draw:fill="bitmap" draw:fill-image-name="Plain" style:repeat="repeat" draw:fill-image-width="2cm" draw:fill-image-height="1cm" draw:fill-image-ref-point-x="50%" draw:fill-image-ref-point-y="25%" draw:stroke="solid" svg:stroke-color="#000000"/></style:style>
   <style:style style:name="fill4" style:family="graphic"><style:graphic-properties draw:fill="bitmap" draw:fill-image-name="Plain" style:repeat="repeat" draw:fill-image-width="2cm" draw:fill-image-height="1cm" draw:tile-repeat-offset="50% horizontal" draw:stroke="solid" svg:stroke-color="#000000"/></style:style>
   <style:style style:name="fill5" style:family="graphic"><style:graphic-properties draw:fill="bitmap" draw:fill-image-name="Plain" style:repeat="repeat" draw:fill-image-width="2cm" draw:fill-image-height="1cm" draw:tile-repeat-offset="50% vertical" draw:stroke="solid" svg:stroke-color="#000000"/></style:style>
   <style:style style:name="fill6" style:family="graphic"><style:graphic-properties draw:fill="bitmap" draw:fill-image-name="Plain" style:repeat="repeat" draw:fill-image-width="25%" draw:fill-image-height="25%" draw:stroke="solid" svg:stroke-color="#000000"/></style:style>
   <style:style style:name="fill7" style:family="graphic"><style:graphic-properties draw:fill="bitmap" draw:fill-image-name="Plain" style:repeat="no-repeat" draw:fill-image-width="2cm" draw:fill-image-height="1cm" draw:fill-image-ref-point="top-left" draw:stroke="solid" svg:stroke-color="#000000"/></style:style>
   <style:style style:name="fill8" style:family="graphic"><style:graphic-properties draw:fill="bitmap" draw:fill-image-name="Dense" style:repeat="repeat" draw:stroke="solid" svg:stroke-color="#000000"/></style:style>
   <style:style style:name="fill9" style:family="graphic"><style:graphic-properties draw:fill="bitmap" draw:fill-image-name="Plain" style:repeat="stretch" draw:stroke="solid" svg:stroke-color="#000000"/></style:style>
 </office:styles>
 <office:automatic-styles>
   <style:page-layout style:name="Page"><style:page-layout-properties fo:page-width="28cm" fo:page-height="15.75cm" fo:margin-top="0cm" fo:margin-bottom="0cm" fo:margin-left="0cm" fo:margin-right="0cm"/></style:page-layout>
   <style:style style:name="ground" style:family="drawing-page"><style:drawing-page-properties draw:background-size="full" draw:fill="bitmap" draw:fill-image-name="Plain" style:repeat="repeat" draw:fill-image-width="1cm" draw:fill-image-height="0.5cm"/></style:style>
 </office:automatic-styles>
 <office:master-styles><style:master-page style:name="Plain" style:page-layout-name="Page"/></office:master-styles>
 <office:body>
  <office:presentation>
   <draw:page draw:name="Tiles at the picture's own size" draw:master-page-name="Plain"><draw:frame presentation:class="title" svg:x="1cm" svg:y="0.5cm" svg:width="26cm" svg:height="2cm"><draw:text-box><text:p>Tiles at the picture's own size</text:p></draw:text-box></draw:frame><draw:rect draw:style-name="fill0" svg:x="3cm" svg:y="3cm" svg:width="11cm" svg:height="7cm"/></draw:page>
   <draw:page draw:name="Tiles at the size the style gives" draw:master-page-name="Plain"><draw:frame presentation:class="title" svg:x="1cm" svg:y="0.5cm" svg:width="26cm" svg:height="2cm"><draw:text-box><text:p>Tiles at the size the style gives</text:p></draw:text-box></draw:frame><draw:rect draw:style-name="fill1" svg:x="3cm" svg:y="3cm" svg:width="11cm" svg:height="7cm"/></draw:page>
   <draw:page draw:name="Tiles against the bottom right corner" draw:master-page-name="Plain"><draw:frame presentation:class="title" svg:x="1cm" svg:y="0.5cm" svg:width="26cm" svg:height="2cm"><draw:text-box><text:p>Tiles against the bottom right corner</text:p></draw:text-box></draw:frame><draw:rect draw:style-name="fill2" svg:x="3cm" svg:y="3cm" svg:width="11cm" svg:height="7cm"/></draw:page>
   <draw:page draw:name="Tiles moved by a share of a tile" draw:master-page-name="Plain"><draw:frame presentation:class="title" svg:x="1cm" svg:y="0.5cm" svg:width="26cm" svg:height="2cm"><draw:text-box><text:p>Tiles moved by a share of a tile</text:p></draw:text-box></draw:frame><draw:rect draw:style-name="fill3" svg:x="3cm" svg:y="3cm" svg:width="11cm" svg:height="7cm"/></draw:page>
   <draw:page draw:name="Alternate rows moved across" draw:master-page-name="Plain"><draw:frame presentation:class="title" svg:x="1cm" svg:y="0.5cm" svg:width="26cm" svg:height="2cm"><draw:text-box><text:p>Alternate rows moved across</text:p></draw:text-box></draw:frame><draw:rect draw:style-name="fill4" svg:x="3cm" svg:y="3cm" svg:width="11cm" svg:height="7cm"/></draw:page>
   <draw:page draw:name="Alternate columns moved down" draw:master-page-name="Plain"><draw:frame presentation:class="title" svg:x="1cm" svg:y="0.5cm" svg:width="26cm" svg:height="2cm"><draw:text-box><text:p>Alternate columns moved down</text:p></draw:text-box></draw:frame><draw:ellipse draw:style-name="fill5" svg:x="3cm" svg:y="3cm" svg:width="11cm" svg:height="7cm"/></draw:page>
   <draw:page draw:name="Tiles a quarter of the shape" draw:master-page-name="Plain"><draw:frame presentation:class="title" svg:x="1cm" svg:y="0.5cm" svg:width="26cm" svg:height="2cm"><draw:text-box><text:p>Tiles a quarter of the shape</text:p></draw:text-box></draw:frame><draw:rect draw:style-name="fill6" svg:x="3cm" svg:y="3cm" svg:width="11cm" svg:height="7cm"/></draw:page>
   <draw:page draw:name="One picture in the top left corner" draw:master-page-name="Plain"><draw:frame presentation:class="title" svg:x="1cm" svg:y="0.5cm" svg:width="26cm" svg:height="2cm"><draw:text-box><text:p>One picture in the top left corner</text:p></draw:text-box></draw:frame><draw:rect draw:style-name="fill7" svg:x="3cm" svg:y="3cm" svg:width="11cm" svg:height="7cm"/></draw:page>
   <draw:page draw:name="A picture saved at 72 dots per inch" draw:master-page-name="Plain"><draw:frame presentation:class="title" svg:x="1cm" svg:y="0.5cm" svg:width="26cm" svg:height="2cm"><draw:text-box><text:p>A picture saved at 72 dots per inch</text:p></draw:text-box></draw:frame><draw:rect draw:style-name="fill8" svg:x="3cm" svg:y="3cm" svg:width="11cm" svg:height="7cm"/></draw:page>
   <draw:page draw:name="A picture stretched" draw:master-page-name="Plain"><draw:frame presentation:class="title" svg:x="1cm" svg:y="0.5cm" svg:width="26cm" svg:height="2cm"><draw:text-box><text:p>A picture stretched</text:p></draw:text-box></draw:frame><draw:rect draw:style-name="fill9" svg:x="3cm" svg:y="3cm" svg:width="11cm" svg:height="7cm"/></draw:page>
   <draw:page draw:name="A tiled background" draw:master-page-name="Plain" draw:style-name="ground"><draw:frame presentation:class="title" svg:x="1cm" svg:y="0.5cm" svg:width="26cm" svg:height="2cm"><draw:text-box><text:p>A tiled background</text:p></draw:text-box></draw:frame></draw:page>
  </office:presentation>
 </office:body>
</office:document>
