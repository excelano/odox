    <text:changed-region text:id="ct3"><text:deletion><office:change-info><dc:creator>Ben Editor</dc:creator><dc:date>2026-03-15T10:05:00</dc:date></office:change-info><text:p text:style-name="Standard"> and then some</text:p><text:p text:style-name="Standard">A whole line once stood here, and</text:p></text:deletion></text:changed-region>
