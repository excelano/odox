# The package identities Partner Center assigned, in one place.
#
# **This file is a template. Copy it to `identity.psd1` beside this one and put
# the real values in.** That copy is not committed: `.gitignore` keeps it out,
# because a public repository is not where an account's identifiers go, even the
# ones that are not secret. `build-msix.ps1` refuses with this file's name in the
# message when the copy is missing, so a fresh checkout finds out what it needs
# rather than failing at `makeappx`.
#
# **Three identities, one per application**, because odox ships three store
# packages rather than one. That is the shape that differs from the rest of the
# fleet, where this file is a single hashtable. `Publisher` and
# `PublisherDisplayName` are per-account and are therefore the same in all three;
# only `Name` and the calculated forms differ.
#
# WHERE THE VALUES COME FROM, AND WHY THEY CANNOT BE GUESSED
#
# All of them are assigned when the name is reserved, and Partner Center shows
# them under Product management, then Product identity. A package whose identity
# disagrees with the reservation is rejected at upload rather than at review, so
# there is no way to discover a wrong value except by trying one.
#
# `Publisher` is the X.500 string and not the display name. It is the value most
# often copied wrong, and it is also the subject a test-signing certificate must
# carry exactly: `signtool` refuses to sign a package whose manifest `Publisher`
# and whose certificate subject differ. `build-msix.ps1 -SelfSign` builds the
# subject from this value rather than from anything typed a second time.
#
# The MSA application id on the same page is needed by nothing here. Do not put
# it in the copy.
#
# Author: David M. Anderson
# Built with AI assistance (Claude, Anthropic)
@{
    # Per-account, and the same for all three packages.
    Publisher = 'CN=00000000-0000-0000-0000-000000000000'
    PublisherDisplayName = 'Your publisher display name'

    # Per-product. The key is the binary, which is what `build-msix.ps1` is given.
    #
    # `PackageFamilyName` and `StoreId` are not manifest values; Partner Center
    # calls them calculated forms. The family name is a hash of the two identity
    # values and the store id is what the listing URL is built from. They are
    # here because they are what verifies an install and what links the listing,
    # and both are otherwise only findable by logging in.
    #
    #   Get-AppxPackage PUBLISHER.AppName
    #   https://apps.microsoft.com/detail/<StoreId>
    Applications = @{
        xodt = @{
            Name = 'PUBLISHER.AppName'
            PackageFamilyName = 'PUBLISHER.AppName_0000000000000'
            StoreId = '000000000000'
        }
        xods = @{
            Name = 'PUBLISHER.AppName'
            PackageFamilyName = 'PUBLISHER.AppName_0000000000000'
            StoreId = '000000000000'
        }
        xodp = @{
            Name = 'PUBLISHER.AppName'
            PackageFamilyName = 'PUBLISHER.AppName_0000000000000'
            StoreId = '000000000000'
        }
    }
}
